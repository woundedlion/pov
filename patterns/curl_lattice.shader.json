      {
        "id": "hue-noise",
        "kind": "simplex-sphere-scalar",
        "settings": { "seed": 6047, "generator_frequency": 1 }
      },
      {
        "id": "triadic-palette",
        "kind": "generated-triadic-palette",
        "settings": { "initial_hue": 0, "hue_step": 159, "chroma": 1 }
      }
