			)
			(fill no)
			(layer "Cmts.User")
		)
		(fp_circle
			(center 0 0)
			(end 2.95 0)
			(stroke
				(width 0.05)
				(type solid)
			)
			(fill no)
			(layer "F.CrtYd")
		)
		(fp_text user "${REFERENCE}"
			(at 0 0 0)
			(layer "F.Fab")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
		(pad "" np_thru_hole circle
			(at 0 0)
			(size 2.7 2.7)
			(drill 2.7)
			(layers "*.Cu" "*.Mask")
		)
		(embedded_fonts no)
	)
)
