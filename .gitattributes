.githooks/** text eol=lf

# Shell scripts, for the same reason: a CRLF `#!/bin/bash` shebang is not an
# interpreter path any shell resolves.
*.sh text eol=lf

# First-party and vendored C++. The pre-commit clang-format gate judges the
# STAGED blob and states that blob is LF regardless of core.autocrlf; only this
# pin makes that true for a contributor with core.autocrlf=false.
*.h text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.inl text eol=lf

# Generated tables. Their generators emit LF on every host, so pin the checked-in
# bytes to LF regardless of core.autocrlf.
core/color/color_luts.h text eol=lf
core/color/gamut_lut.h text eol=lf
core/color/srgb_decode_lut.h text eol=lf
core/spatial/reaction_graph.cpp text eol=lf
core/mesh/relax_bakes_generated.h text eol=lf
tools/teensy_warning_baseline.txt text eol=lf

# Same, for the segment-map golden. Its exporter writes to stdout, which picks up
# CRLF on Windows, and the daydream deploy gate diffs the checked-in bytes against
# the engine's copy on a Linux runner.
hardware/pov_segment_map.json text eol=lf

# The chain-catalog golden is byte-compared against the LF bytes
# append_catalog_json() emits, on every host.
tests/data/shader_chain_catalog.json text eol=lf

# The remaining installed artifacts the deploy gate byte-compares across the two
# repositories. The gallery PNGs are pinned binary so no host's autocrlf can
# touch them.
README.md text eol=lf
docs/screenshots/** binary
