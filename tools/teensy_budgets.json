{
  // ==========================================================================
  // Teensy 4 firmware size + layout budgets — consumed by tools/teensy_gate.py.
  // This file and that module state the gate's ceilings and layout invariants;
  // nothing else is normative. // line comments only (tests/CMakeLists.txt also reads this file).
  //
  // RAM1 usage is DTCM variables plus ITCM code rounded to whole 32 KiB banks.
  // Stack headroom is total FlexRAM minus that usage; current builds supply the
  // measured components. Fixtures in teensy_gate_tests/fixtures/real preserve
  // historical builds for parser and layout regression tests.
  //
  // Symbol names are the REAL linkage names from `readelf -s`: the arena is
  // file-scope static, so it mangles to `_ZL18global_arena_block` (NOT the source
  // spelling). A renamed/missing layout symbol is a hard failure, never a silent
  // pass. Raising a ceiling is a reviewed one-line edit landed with the change that
  // needs it.
  // ==========================================================================

  "holosphere": {
    "regions": {
      // Holosphere runs nonstrobed RingSpin at 96x20 and sizes its framebuffers to that
      // canvas, so every region retains wide headroom.
      // FLASH max_bytes is the T4.0 2 MB device wall, held below 100% so there
      // is room to flash — a "won't fit" cap, not a ratchet. Image growth is
      // tracked by tools/teensy_size_trail.py instead.
      "flash": { "max_bytes": 1900000 },
      "ram1":  { "max_bytes": 490000 },
      // OCRAM: 44,160 B used, 480,128 B free. max_bytes is the hardware wall;
      // free_min_bytes reserves 4 KiB for the heap-allocated effect object plus
      // allocator and boot overhead.
      "ram2":  { "max_bytes": 524288, "free_min_bytes": 4096 }
    },
    "symbols": {
      "arena":         { "name": "_ZL18global_arena_block", "region": "DTCM", "min_bytes": 294912, "max_bytes": 327680 }, // 305,152 B (298 KiB)
      "framebuffer_a": { "name": "_ZN6Effect8buffer_aE",    "region": "OCRAM" },
      "framebuffer_b": { "name": "_ZN6Effect8buffer_bE",    "region": "OCRAM" }
      // NOTE: reaction_graph (ReactionGraph::neighbors) is GC'd out of Holosphere
      // — RingSpin uses no reaction-diffusion effect — so it is intentionally NOT
      // a layout symbol here. It IS checked for Phantasm (below).
    }
  },

  "phantasm": {
    "regions": {
      // -Os + nano + flash routing and a 298 KiB arena. The shipping
      // image may use all padding within its six ITCM banks; allocating a
      // seventh bank fails the stack-floor-derived ceiling.
      // FLASH max_bytes is the same device wall as Holosphere's, not a ratchet.
      "flash": { "max_bytes": 1900000 },
      // free_min_bytes is the DTCM stack reservation. The host stack-painting
      // gate (tests/stack_measure.cpp) reports the current peak on its WORST:
      // line. The 12 KiB floor includes the ISR allowance. max_bytes =
      // 524288 - 12288, so the stack floor is the binding RAM1 constraint.
      // The RAM1 total, free floor, and zero-reserve derived code ceiling
      // enforce one constraint. The derived check supplies the bank-boundary
      // note and can additionally reserve min_headroom_bytes before it.
      // The ITCM code ceiling is DERIVED from that same stack floor: FlexRAM
      // is 16 x 32 KiB banks split between ITCM (code) and DTCM (variables +
      // stack), so DTCM must keep ceil((variables + free_min_bytes) / 32768)
      // banks and code may fill the rest. Code grows freely up to that
      // bank-granular ceiling; cold logic is proactively HS_COLD-routed by
      // convention, and the gate's informational line tracks measured code,
      // remaining headroom, and distance to the next bank boundary in every
      // run.
      "ram1":  { "max_bytes": 512000, "free_min_bytes": 12288,
                 "components": { "code": { "max_banks_from_stack_floor": {
                     "bank_bytes": 32768, "total_banks": 16,
                     "min_headroom_bytes": 0 } } } },
      // 3.5 KiB effect-object cap plus 512 B for allocator and boot overhead.
      "ram2":  { "max_bytes": 524288, "free_min_bytes": 4096 }
    },
    "symbols": {
      "arena":          { "name": "_ZL18global_arena_block",        "region": "DTCM", "min_bytes": 294912, "max_bytes": 327680 },
      "framebuffer_a":  { "name": "_ZN6Effect8buffer_aE",          "region": "OCRAM" },
      "framebuffer_b":  { "name": "_ZN6Effect8buffer_bE",          "region": "OCRAM" },
      // Phantasm instantiates reaction-diffusion effects, so the K-NN
      // table is present and must stay in flash (const => flash/.rodata).
      // Verified on the real Phantasm ELF.
      "reaction_graph": { "name": "_ZN13ReactionGraph9neighborsE", "region": "FLASH" },
      // The segment LED controller's HD107SFrame buffers are the eDMA TX source and
      // stay in OCRAM to preserve RAM1/DTCM capacity. Cached OCRAM requires
      // arm_dcache_flush() before DMA. Emitted by HS_DEFINE_POV_SEGMENTED_LED_CONTROLLER in
      // targets/Phantasm/phantasm_target.h because GCC drops DMAMEM on the
      // vague-linkage template static member.
      "dma_tx_buffer":  { "name": "_ZN12POVSegmentedILi288ELi4ELi480EE13ledControllerE", "region": "OCRAM" }
    }
  }
}
