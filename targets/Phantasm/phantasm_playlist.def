// Phantasm device playlist, one row per line, in show order.
//   show(Effect, seconds)  plays for a fixed number of seconds
//   show(Effect)           plays one cycle, as the effect defines it
//   exclude(Effect)        a roster effect left off the device
// Every roster effect except ShaderChain appears exactly once, in a show or
// an exclude row. Expanded through phantasm_playlist_rows.h.

show(LiquidWindows, 60)
show(GridWarp, 60)
show(Iridescence, 60)
show(Involution, 60)
show(HopfFibration, 60)
show(Millefiori, 60)
show(Galaxies, 60)
show(DreamBalls)
show(KaleidoscopeFlowers)
show(MeshFeedback)
show(ShapeShifter)
show(MindSplatter)
show(Raymarch, 30)
show(AlienBrain)
show(GridSpace, 60)
show(GridWorms, 60)
show(IslamicStars)
show(BZReactionDiffusion, 60)
show(HyperLattice)
show(AshCloud, 60)
show(Fishbowl, 60)
show(Comets)
show(ChromaticLichen, 30)
show(MermaidSkin, 30)
show(DisplacementField)
show(KaleidoscopeMandala)
show(GnomonicStars, 30)
show(GSReactionDiffusion, 30)
show(AlienCore, 30)
show(HankinSolids)
show(KaleidoscopeHexBright)
show(AlienOcean, 30)
show(MobiusGrid)
show(PetalFlow, 30)
show(KaleidoscopeHexOil)
show(RingSpin, 60)
show(SphericalHarmonics)
show(CosmicEyeball, 60)
show(KaleidoscopeSmooth)

exclude(JewelMelt)
exclude(KaleidoscopeStainedGlass)
exclude(KaleidoscopeMelt)
exclude(Dynamo) // 96x20 only
exclude(MobiusRings) // 96x20 only
exclude(RingShower)
exclude(Thrusters) // 96x20 only
