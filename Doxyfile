# Doxygen configuration for Holosphere. Only non-default keys are set here;
# Doxygen supplies defaults for everything omitted. HTML output lands in
# build/docs/html (gitignored). CI (.github/workflows/docs.yml) appends the
# doxygen-awesome theme stylesheet before generating.

PROJECT_NAME           = "Holosphere"
PROJECT_BRIEF          = "Persistence-of-vision LED sphere engine and WebAssembly simulator"
OUTPUT_DIRECTORY       = build/docs
USE_MDFILE_AS_MAINPAGE = README.md

# Document the engine, effects, hardware drivers, and both target flavors — the
# WASM bridge and the Arduino .ino firmware entry points. Tests are omitted from
# the API reference on purpose.
INPUT                  = README.md core effects hardware targets
FILE_PATTERNS          = *.h *.cpp *.ino
# .ino is Arduino C++; Doxygen has no built-in mapping for the extension.
EXTENSION_MAPPING      = ino=C++
RECURSIVE              = YES
# Vendored (FastNoiseLite) and generated (LUT/bake tables) — never document these.
EXCLUDE                = core/vendor/FastNoiseLite.h \
                         core/color/color_luts.h \
                         core/color/gamut_lut.h \
                         core/color/srgb_decode_lut.h \
                         core/color/triadic_palette_luts.h \
                         core/spatial/reaction_graph.cpp \
                         core/mesh/relax_bakes_generated.h

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIV_VIRTUAL   = YES

# Teensy section/placement macros expand to nothing off-device. Doxygen does not
# take the platform preprocessor branch, so define them away here to keep the
# parser seeing plain declarations. __EMSCRIPTEN__ gates the entire WASM bridge
# (targets/wasm/wasm.cpp) plus the effect registry it drives, so without it the
# JS-facing API publishes as an empty File Reference.
#
# EXPAND_ONLY_PREDEF keeps core/platform/build_features.h's defaults out of the
# conditionals, so every feature macro the simulator build enables is spelled
# out here; an omitted one publishes its headers as empty File References.
# ARDUINO stays undefined: it is exclusive with the host branch of
# core/platform/platform.h, which carries HS_CHECK, the EVERY_N_* timers and
# hs::millis/micros, and taking it would trade those for the three device-only
# driver headers.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = FLASHMEM= \
                         FASTRUN= \
                         PROGMEM= \
                         DMAMEM= \
                         "__attribute__(x)=" \
                         __EMSCRIPTEN__=1 \
                         DOXYGEN=1 \
                         HS_ENABLE_EFFECT_REGISTRY=1 \
                         HS_ENABLE_PARAM_GUI_BRIDGE=1 \
                         HS_ENABLE_SHADERBALL_DYNAMIC_BACKEND=1 \
                         HS_ENABLE_SHADER_WORKBENCH=1 \
                         HS_ENABLE_CHAIN_INTERPRETER=1

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
# Match the README's GitHub-style heading anchors so its in-page TOC links
# (e.g. [Hardware](#1-hardware)) resolve on the generated mainpage.
MARKDOWN_ID_STYLE      = GITHUB

# Inheritance/collaboration graphs (the Effect hierarchy, filter Pipelines).
# Requires Graphviz; CI installs it.
HAVE_DOT               = YES
COLLABORATION_GRAPH    = YES
DOT_GRAPH_MAX_NODES    = 100
CALL_GRAPH             = NO

QUIET                  = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
