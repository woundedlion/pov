+/** @brief Checks acute and collinear vertex cones in both polygon windings. */
+inline void test_face_convex_vertex_distance() {
+  const math::Vector acute[] = {math::Vector(0.8f, 0.0f, 1.0f).normalized(),
+                                math::Vector(-0.4f, 0.08f, 1.0f).normalized(),
+                                math::Vector(-0.4f, -0.08f, 1.0f).normalized()};
+  const math::Vector collinear[] = {
+      math::Vector(-0.5f, -0.5f, 1.0f).normalized(),
+      math::Vector(0.0f, -0.5f, 1.0f).normalized(),
+      math::Vector(0.5f, -0.5f, 1.0f).normalized(),
+      math::Vector(0.5f, 0.0f, 1.0f).normalized(),
+      math::Vector(0.5f, 0.5f, 1.0f).normalized(),
+      math::Vector(0.0f, 0.5f, 1.0f).normalized(),
+      math::Vector(-0.5f, 0.5f, 1.0f).normalized(),
+      math::Vector(-0.5f, 0.0f, 1.0f).normalized()};
+  for (const auto vertices : {std::span<const math::Vector>(acute),
+                              std::span<const math::Vector>(collinear)}) {
+    for (bool reverse : {false, true}) {
+      uint16_t indices[8];
+      for (size_t i = 0; i < vertices.size(); ++i)
+        indices[i] =
+            static_cast<uint16_t>(reverse ? vertices.size() - 1 - i : i);
+      SDF::FaceScratchBuffer scratch;
+      SDF::Face face(vertices,
+                     std::span<const uint16_t>(indices, vertices.size()),
+                     scratch, 144 + hs::H_OFFSET, 144);
+      HS_EXPECT_TRUE(face.convex);
+      for (int x = -40; x <= 40; ++x) {
+        for (int y = -40; y <= 40; ++y) {
+          const float px = x * 0.03f, py = y * 0.03f;
+          const math::Vector p =
+              (face.basis_v + face.basis_u * px + face.basis_w * py)
+                  .normalized();
+          const float expected = exact_plane_distance(vertices, p, true);
+          HS_EXPECT_NEAR(face.plane_dist_convex(px, py), expected, 1e-5f);
+        }
+      }
+    }
+  }
+}
