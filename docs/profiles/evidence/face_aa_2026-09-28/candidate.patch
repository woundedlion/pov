@@ -1398,6 +1394,19 @@ struct Face {
       float di = hp.nx * px + hp.ny * py + hp.off;
       d = __builtin_fmaxf(di, d);
     }
+    if (d > 0.0f) {
+      const auto *before = &packed_edges[count - 1];
+      for (int i = 0; i < count; ++i) {
+        const auto &after = packed_edges[i];
+        const float vx = px - after.vx, vy = py - after.vy;
+        // The projection origin is strictly interior, including collinear edges.
+        if (vx * after.vx + vy * after.vy > 0.0f &&
+            vx * before->ex + vy * before->ey >= 0.0f &&
+            vx * after.ex + vy * after.ey <= 0.0f)
