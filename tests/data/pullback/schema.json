{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holosphere.local/schemas/pullback-manifest-v1.json",
  "title": "Holosphere pullback verification manifest",
  "oneOf": [
    { "$ref": "#/$defs/programManifest" },
    { "$ref": "#/$defs/oracleManifest" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["schema_version", "kind", "base_sha", "toolchains"],
      "properties": {
        "schema_version": { "const": 1 },
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "toolchains": {
          "type": "object",
          "required": ["native", "wasm", "teensy"]
        }
      }
    },
    "programManifest": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "properties": {
            "kind": { "const": "pullback-programs" },
            "programs": { "type": "array", "minItems": 11, "maxItems": 11 }
          },
          "required": ["corpus", "programs"]
        }
      ]
    },
    "oracleManifest": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "properties": {
            "kind": { "const": "pullback-oracle" },
            "metrics": { "type": "array", "minItems": 1 }
          },
          "required": [
            "oracle_id", "exact_callable", "non_floating_fields_exact",
            "corpus", "metrics"
          ]
        }
      ]
    }
  }
}
