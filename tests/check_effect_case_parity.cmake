cmake_minimum_required(VERSION 3.29)
include("${CMAKE_CURRENT_LIST_DIR}/header_sections.cmake")

function(effect_runner_cases path output)
  file(READ "${path}" text)
  hs_strip_cxx_noise(text)
  string(REGEX MATCH "int run_[A-Za-z0-9_]+_tests\\([ \t\r\n]*\\)[ \t\r\n]*\\{" signature "${text}")
  if(signature STREQUAL "")
    message(FATAL_ERROR "${path}: missing effect runner")
  endif()
  string(FIND "${text}" "${signature}" start)
  string(SUBSTRING "${text}" ${start} -1 text)
  string(REGEX MATCHALL
    "if[ \t\r\n]*\\([^{}]*\\)[ \t\r\n]*\\{|[{}]|run_effect_case_[A-Za-z0-9_]+[ \t\r\n]*\\([ \t\r\n]*\\)[ \t\r\n]*;"
    tokens "${text}")
  set(depth 0)
  set(skip_depth 0)
  set(full_depth 0)
  set(cases)
  foreach(token IN LISTS tokens)
    if(token MATCHES "\\{$")
      math(EXPR depth "${depth} + 1")
      if(token MATCHES "^if" AND token MATCHES "_only" AND NOT skip_depth)
        set(skip_depth ${depth})
      elseif(token MATCHES "^if" AND token MATCHES "effects_full_suite")
        set(full_depth ${depth})
      endif()
    elseif(token STREQUAL "}")
      if(depth EQUAL skip_depth)
        set(skip_depth 0)
      endif()
      if(depth EQUAL full_depth)
        set(full_depth 0)
      endif()
      math(EXPR depth "${depth} - 1")
      if(depth EQUAL 0)
        break()
      endif()
    elseif(NOT skip_depth AND token MATCHES "^(run_effect_case_[A-Za-z0-9_]+)")
      set(name "${CMAKE_MATCH_1}")
      if(full_depth)
        set(tier FULL)
      else()
        set(tier QUICK)
      endif()
      if("${name}|${tier}" IN_LIST cases)
        message(FATAL_ERROR "${path}: duplicate case ${name}")
      endif()
      list(APPEND cases "${name}|${tier}")
    endif()
  endforeach()
  if(NOT cases)
    message(FATAL_ERROR "${path}: empty effect runner")
  endif()
  list(SORT cases)
  set(${output} "${cases}" PARENT_SCOPE)
endfunction()

effect_runner_cases("${TESTS_DIR}/test_effects.h" umbrella)
file(GLOB sources "${TESTS_DIR}/run_effect_cases_*.cpp")
if(NOT sources)
  message(FATAL_ERROR "no focused effect runners found")
endif()
set(covered)
foreach(source IN LISTS sources)
  file(READ "${source}" text)
  hs_strip_cxx_noise(text)
  string(REGEX MATCHALL "void[ \t\r\n]+run_effect_case_[A-Za-z0-9_]+[ \t\r\n]*\\(" declarations "${text}")
  set(owned)
  foreach(declaration IN LISTS declarations)
    string(REGEX MATCH "run_effect_case_[A-Za-z0-9_]+" name "${declaration}")
    list(APPEND owned "${name}")
  endforeach()
  set(expected)
  foreach(case IN LISTS umbrella)
    string(REGEX REPLACE "\\|.*$" "" name "${case}")
    if(name IN_LIST owned)
      list(APPEND expected "${case}")
    endif()
  endforeach()
  effect_runner_cases("${source}" actual)
  if(NOT "${expected}" STREQUAL "${actual}")
    message(FATAL_ERROR "${source}: effect case membership/tier mismatch\nexpected: ${expected}\nactual: ${actual}")
  endif()
  list(APPEND covered ${expected})
endforeach()
list(SORT covered)
if(NOT "${covered}" STREQUAL "${umbrella}")
  message(FATAL_ERROR "umbrella effect cases must have exactly one focused owner")
endif()
message(STATUS "focused effect case membership and tiers match the umbrella")
