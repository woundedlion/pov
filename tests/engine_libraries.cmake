# Share native engine objects only across compatible compile contexts.

function(hs_engine_compile_context target prefix)
  foreach(property IN ITEMS COMPILE_DEFINITIONS COMPILE_OPTIONS
                            INCLUDE_DIRECTORIES COMPILE_FEATURES)
    get_target_property(value ${target} ${property})
    if(value STREQUAL "value-NOTFOUND")
      set(value)
    endif()
    set(context_${property} "${value}")
  endforeach()
  get_target_property(pending ${target} LINK_LIBRARIES)
  set(visited)
  while(pending)
    list(POP_FRONT pending dependency)
    if(NOT TARGET "${dependency}" OR dependency IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${dependency}")
    foreach(property IN ITEMS COMPILE_DEFINITIONS COMPILE_OPTIONS
                              INCLUDE_DIRECTORIES COMPILE_FEATURES)
      get_target_property(value ${dependency} INTERFACE_${property})
      if(NOT value STREQUAL "value-NOTFOUND")
        list(APPEND context_${property} ${value})
      endif()
    endforeach()
    get_target_property(value ${dependency} INTERFACE_LINK_LIBRARIES)
    if(NOT value STREQUAL "value-NOTFOUND")
      list(APPEND pending ${value})
    endif()
  endwhile()
  foreach(property IN ITEMS COMPILE_DEFINITIONS COMPILE_OPTIONS
                            INCLUDE_DIRECTORIES COMPILE_FEATURES)
    set(${prefix}_${property} "${context_${property}}" PARENT_SCOPE)
  endforeach()
endfunction()

function(hs_share_test_engines)
  set(engine_sources)
  foreach(source IN LISTS HS_ENGINE_SOURCES HS_CAPTURE_ENGINE_SOURCES)
    file(REAL_PATH "${source}" absolute)
    list(APPEND engine_sources "${absolute}")
  endforeach()
  list(REMOVE_DUPLICATES engine_sources)
  get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  set(report "")
  set(objects)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    if(NOT type STREQUAL "EXECUTABLE")
      continue()
    endif()
    get_target_property(sources ${target} SOURCES)
    set(owned_engine_sources)
    set(remaining_sources)
    foreach(source IN LISTS sources)
      if(source MATCHES "^\\$<")
        list(APPEND remaining_sources "${source}")
        continue()
      endif()
      get_filename_component(absolute "${source}" ABSOLUTE
                             BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
      if(EXISTS "${absolute}")
        file(REAL_PATH "${absolute}" absolute)
      endif()
      if(absolute IN_LIST engine_sources)
        list(APPEND owned_engine_sources "${absolute}")
      else()
        list(APPEND remaining_sources "${source}")
      endif()
    endforeach()
    if(NOT owned_engine_sources)
      continue()
    endif()

    hs_engine_compile_context(${target} context)
    set(definitions ${context_COMPILE_DEFINITIONS})
    # These knobs are consumed only by test drivers, outside the engine.
    list(FILTER definitions EXCLUDE REGEX
      "^(HS_SHADER_CHAIN_CATALOG_PATH|HS_PROMOTED_PATTERNS_DIR|HS_DEVICE_STACK_FLOOR_BYTES|HS_OFFSET_FULL_RESOLUTION)(=|$)")
    list(REMOVE_DUPLICATES definitions)
    list(SORT definitions)
    set(includes)
    foreach(include IN LISTS context_INCLUDE_DIRECTORIES)
      if(include MATCHES "^\\$<")
        list(APPEND includes "${include}")
      else()
        file(REAL_PATH "${include}" absolute BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT absolute STREQUAL CMAKE_CURRENT_BINARY_DIR)
          list(APPEND includes "${absolute}")
        endif()
      endif()
    endforeach()
    list(REMOVE_DUPLICATES includes)
    set(features ${context_COMPILE_FEATURES})
    list(REMOVE_DUPLICATES features)
    set(context_key "${definitions}|${context_COMPILE_OPTIONS}|${includes}|${features}")
    set(target_objects)
    foreach(source IN LISTS owned_engine_sources)
      string(SHA256 digest "${source}|${context_key}")
      string(SUBSTRING "${digest}" 0 12 digest)
      get_filename_component(stem "${source}" NAME_WE)
      set(object "hs_engine_${stem}_${digest}")
      if(NOT TARGET ${object})
        add_library(${object} OBJECT EXCLUDE_FROM_ALL "${source}")
        set_target_properties(${object} PROPERTIES
          COMPILE_DEFINITIONS "${definitions}"
          COMPILE_OPTIONS "${context_COMPILE_OPTIONS}"
          INCLUDE_DIRECTORIES "${includes}"
          COMPILE_FEATURES "${features}")
        list(APPEND objects "${object}")
        string(APPEND report "${object}\n  definitions: ${definitions}\n  options: ${context_COMPILE_OPTIONS}\n")
      endif()
      list(APPEND target_objects "${object}")
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${remaining_sources}")
    target_link_libraries(${target} PRIVATE ${target_objects})
    set_property(TARGET ${target} PROPERTY HS_ENGINE_OBJECTS "${target_objects}")
    string(APPEND report "${target}: ${target_objects}\n")
  endforeach()
  list(LENGTH objects object_count)
  message(STATUS "Shared native engine compile contexts: ${object_count} source objects")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/engine_compile_contexts.txt" "${report}")
endfunction()
