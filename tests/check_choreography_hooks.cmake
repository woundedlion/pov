cmake_minimum_required(VERSION 3.29)
set(define_flags)
foreach(definition IN LISTS DEFINES)
  list(APPEND define_flags "-D${definition}")
endforeach()
function(check_fixture expected)
  execute_process(COMMAND "${COMPILER}" -std=gnu++20 -fsyntax-only
    "-I${ROOT}" ${define_flags} ${ARGN}
    "${ROOT}/tests/choreography_hooks_check.cpp"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected STREQUAL "PASS")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "valid hook companion rejected: ${output}${error}")
    endif()
  elseif(result EQUAL 0)
    message(FATAL_ERROR "invalid hook contract accepted: ${ARGN}")
  elseif(NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "wrong hook contract refusal: ${output}${error}")
  endif()
endfunction()
check_fixture(PASS)
check_fixture(PASS -DHS_HOOK_PRESET_ROW)
check_fixture("preset.index. requires PRESET_IDS" -DHS_HOOK_PRESET_ROW -DHS_HOOK_PRESET_ROW_NO_IDS)
check_fixture("choreography hooks: wrong hook signature" -DHS_HOOK_BOUND_TYPO)
check_fixture("choreography hooks: wrong hook signature" -DHS_HOOK_BAD_RETURN)
check_fixture("choreography hooks: wrong hook signature" -DHS_HOOK_BAD_ARGUMENT)
check_fixture("choreography hooks: bound inherited default" -DHS_HOOK_INHERITED_DEFAULT)
check_fixture("choreography hooks: bound inherited default" -DHS_HOOK_VALIDATION_DEFAULT)
check_fixture("choreography hooks: duplicate binding" -DHS_HOOK_DUPLICATE)
check_fixture("choreography hooks: declaration owner mismatch" -DHS_HOOK_FACTORY_TYPO)
message(STATUS "choreography hook contracts passed")
