add_library(hs_test_main STATIC test_main.cpp)
target_link_libraries(hs_test_main PRIVATE hs_test_support)
target_include_directories(hs_test_main PRIVATE ${HS_ROOT})
_hs_warnings(hs_test_main)
_hs_sanitize(hs_test_main)

set(_hs_engine_groups foundation geometry render hardware)
set(_hs_roster_groups effects registry plot_parity death)
set(_hs_effect_groups color conway_effect hyper_lattice shader_chain mindsplatter shapeshifter)
set(_hs_case_targets)
set(_hs_test_group_sources)
get_target_property(_hs_module_definitions run_tests COMPILE_DEFINITIONS)
foreach(_group IN LISTS _hs_engine_groups _hs_roster_groups _hs_effect_groups)
  set(_source "${CMAKE_CURRENT_SOURCE_DIR}/run_${_group}_tests.cpp")
  set(_hs_group_source_${_group} "${_source}")
  list(APPEND _hs_test_group_sources "${_source}")
  add_library(hs_cases_${_group} OBJECT "${_source}")
  target_link_libraries(hs_cases_${_group} PRIVATE hs_test_support)
  target_include_directories(hs_cases_${_group} PRIVATE ${HS_ROOT} ${CMAKE_CURRENT_BINARY_DIR})
  target_compile_definitions(hs_cases_${_group} PRIVATE ${_hs_module_definitions})
  _hs_warnings(hs_cases_${_group})
  _hs_sanitize(hs_cases_${_group})
  list(APPEND _hs_case_targets hs_cases_${_group})
endforeach()
target_compile_definitions(hs_test_main PRIVATE ${_hs_module_definitions})

file(GLOB _hs_effect_case_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/run_effect_cases_*.cpp")
set(_hs_effect_case_objects)
foreach(_source IN LISTS _hs_effect_case_sources)
  get_filename_component(_stem "${_source}" NAME_WE)
  string(REGEX REPLACE "^run_effect_cases_" "" _family "${_stem}")
  set(_group effect_cases_${_family})
  set(_hs_group_source_${_group} "${_source}")
  file(READ "${_source}" _case_text)
  string(REGEX MATCH "int (run_[A-Za-z0-9_]+_tests)\\(\\)" _entry_match "${_case_text}")
  if(NOT _entry_match)
    message(FATAL_ERROR "${_source}: missing family entry point")
  endif()
  set(_hs_group_entry_${_group} "${CMAKE_MATCH_1}")
  add_library(hs_cases_${_group} OBJECT "${_source}")
  target_link_libraries(hs_cases_${_group} PRIVATE hs_test_support)
  target_include_directories(hs_cases_${_group} PRIVATE ${HS_ROOT} ${CMAKE_CURRENT_BINARY_DIR})
  target_compile_definitions(hs_cases_${_group} PRIVATE ${_hs_module_definitions})
  _hs_warnings(hs_cases_${_group})
  _hs_sanitize(hs_cases_${_group})
  list(APPEND _hs_case_targets hs_cases_${_group})
  list(APPEND _hs_effect_case_objects hs_cases_${_group})
  list(APPEND _hs_test_group_sources "${_source}")
  list(APPEND _hs_effect_case_groups ${_group})
endforeach()
add_dependencies(hs_cases_death death_guard_census)

target_link_libraries(run_tests PRIVATE hs_test_main ${_hs_case_targets})
set(_hs_module_targets run_tests hs_test_main)

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_SOURCE_DIR}/run_tests.cpp" ${_hs_test_group_sources})
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/run_tests.cpp" _hs_roster_source)
string(REGEX MATCHALL "X\\(\"[A-Za-z0-9_]+\",[ \t\r\n\\]*[A-Za-z0-9_]+,[ \t\r\n\\]*(true|false)\\)"
  _hs_roster_rows "${_hs_roster_source}")

# Generate a small executable-owned registry over the selected compiled groups.
function(_hs_module_executable target)
  set(_groups ${ARGN})
  set(_entries "")
  set(_objects "")
  foreach(_group IN LISTS _groups)
    file(READ "${_hs_group_source_${_group}}" _group_text)
    string(APPEND _entries "${_group_text}")
    list(APPEND _objects hs_cases_${_group})
  endforeach()
  set(_declarations "")
  set(_rows "")
  foreach(_row IN LISTS _hs_roster_rows)
    string(REGEX REPLACE "X\\(\"([A-Za-z0-9_]+)\",[ \t\r\n\\]*([A-Za-z0-9_]+),[ \t\r\n\\]*(true|false)\\)" "\\1;\\2;\\3" _fields "${_row}")
    list(GET _fields 0 _name)
    list(GET _fields 1 _entry)
    list(GET _fields 2 _tier)
    if(_entries MATCHES "[, ]${_entry}\\)")
      string(APPEND _declarations "int ${_entry}();\n")
      string(APPEND _rows "  {\"${_name}\", module_runners::${_entry}, ${_tier}},\n")
    endif()
  endforeach()
  foreach(_group IN LISTS _groups)
    if(DEFINED _hs_group_entry_${_group})
      set(_entry "${_hs_group_entry_${_group}}")
      string(APPEND _declarations "int ${_entry}();\n")
      string(APPEND _rows "  {\"effects\", module_runners::${_entry}, true},\n")
    endif()
  endforeach()
  if(_rows STREQUAL "")
    message(FATAL_ERROR "${target}: no selected modules")
  endif()
  set(_death "nullptr, nullptr")
  if("death" IN_LIST _groups)
    string(APPEND _declarations "void set_death_self_exe(const char *);\nvoid run_death_child_case(const char *);\n")
    set(_death "module_runners::set_death_self_exe, module_runners::run_death_child_case")
  endif()
  set(_registry "${CMAKE_CURRENT_BINARY_DIR}/${target}_registry.cpp")
  file(CONFIGURE OUTPUT "${_registry}" CONTENT "#include \"tests/module_registry.h\"\nnamespace hs_test::module_runners {\n${_declarations}}\nconst hs_test::TestSuite &hs_test::test_suite() {\n  static const TestModule MODULES[] = {\n${_rows}  };\n  static const TestSuite SUITE{MODULES, ${_death}};\n  return SUITE;\n}\n" @ONLY)
  add_executable(${target} "${_registry}" ${HS_ENGINE_SOURCES})
  target_link_libraries(${target} PRIVATE hs_test_support hs_test_main ${_objects})
  target_compile_definitions(${target} PRIVATE ${_hs_module_definitions})
  target_include_directories(${target} PRIVATE ${HS_ROOT} ${CMAKE_CURRENT_BINARY_DIR})
  _hs_warnings(${target})
  _hs_sanitize(${target})
  set(_hs_module_targets ${_hs_module_targets} ${target} PARENT_SCOPE)
endfunction()

_hs_module_executable(test_engine ${_hs_engine_groups})
_hs_module_executable(test_all_effects ${_hs_roster_groups})
target_link_libraries(test_all_effects PRIVATE ${_hs_effect_case_objects})
foreach(_group IN LISTS _hs_effect_groups)
  if(_group STREQUAL "shapeshifter")
    _hs_module_executable(test_shapeshifter shapeshifter effect_cases_shapeshifter_cases)
  else()
    _hs_module_executable(test_${_group} ${_group})
  endif()
endforeach()

foreach(_group IN LISTS _hs_effect_case_groups)
  string(REGEX REPLACE "^effect_cases_" "" _family "${_group}")
  if(_family STREQUAL "roster")
    continue()
  endif()
  if(_family STREQUAL "shapeshifter_cases")
    # ShapeShifter's oracle and tiles share the effect-local case object.
    continue()
  endif()
  _hs_module_executable(test_${_family} ${_group})
endforeach()
