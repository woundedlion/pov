cmake_minimum_required(VERSION 3.29)
include("${CMAKE_CURRENT_LIST_DIR}/gate_selftest.cmake")
hs_gate_workspace("${GATE}")
file(WRITE "${WORK}/tests/test_alpha.h" "inline int run_alpha_tests() { return 0; }\n")
file(WRITE "${WORK}/tests/test_beta.h" "inline int run_beta_tests() { return 0; }\n")
set(_prefix [=[#include "tests/test_alpha.h"
#include "tests/test_beta.h"
#define HS_TEST_MODULE_LIST(X)
]=])
set(_suffix "\n#define HS_TEST_MODULE_ENTRY\n")
function(check_fixture rows should_pass expected)
  file(WRITE "${WORK}/run_tests.cpp" "${_prefix}${rows}${_suffix}")
  hs_run_gate("${GATE}" _result _output)
  if(should_pass AND NOT _result EQUAL 0)
    message(FATAL_ERROR "valid roster rejected: ${_output}")
  elseif(NOT should_pass AND _result EQUAL 0)
    message(FATAL_ERROR "invalid roster accepted: ${rows}")
  endif()
  if(NOT should_pass)
    string(FIND "${_output}" "${expected}" _diagnostic)
    if(_diagnostic EQUAL -1)
      message(FATAL_ERROR "wrong roster refusal; expected ${expected}: ${_output}")
    endif()
  endif()
endfunction()
set(_valid [=[X("alpha", hs_test::alpha::run_alpha_tests, false)
X("beta", hs_test::beta::run_beta_tests, false)]=])
check_fixture("${_valid}" TRUE "")
check_fixture([=[X("alpha", hs_test::beta::run_beta_tests, false)
X("beta", hs_test::beta::run_beta_tests, false)]=] FALSE "duplicate module entry point in roster")
file(WRITE "${WORK}/tests/test_alpha.h" "inline int alpha_helper() { return 0; }\n")
check_fixture([=[X("alpha", hs_test::alpha::run_missing_tests, false)
X("beta", hs_test::beta::run_beta_tests, false)]=] FALSE "roster entry point has no module definition")
file(WRITE "${WORK}/tests/test_alpha.h" "inline int run_alpha_tests() { return 0; }\n")
check_fixture("${_valid}" TRUE "")
file(APPEND "${WORK}/tests/test_alpha.h" "inline int run_orphan_tests() { return 0; }\n")
check_fixture("${_valid}" FALSE "module entry point is absent from roster")
file(WRITE "${WORK}/tests/test_alpha.h" "inline int run_alpha_tests() { return 0; }\n")
check_fixture("${_valid}" TRUE "")
check_fixture([=[X("alpha", hs_test::alpha::run_alpha_tests, false)]=] FALSE
  "1 HS_TEST_MODULE_LIST rows")
file(WRITE "${WORK}/tests/test_gamma.h" "inline int gamma_helper() { return 0; }\n")
check_fixture("${_valid}" FALSE "run_tests.cpp includes no such header: test_gamma.h")
file(WRITE "${WORK}/tests/off_roster_headers.cmake"
  "set(HS_OFF_ROSTER_HEADER_NAMES test_gamma.h)\n")
check_fixture("${_valid}" FALSE "off_roster_headers.cmake entry nothing includes: test_gamma.h")
file(APPEND "${WORK}/tests/test_beta.h" "#include \"tests/test_gamma.h\"\n")
check_fixture("${_valid}" TRUE "")
message(STATUS "module entry-point controls passed")
