include("${CMAKE_CURRENT_LIST_DIR}/check_mindsplatter_replay_revision.cmake")
if(NOT CASE STREQUAL "drift" AND NOT CASE STREQUAL "missing")
  message(FATAL_ERROR "CASE must be drift or missing")
endif()
if(CHILD)
  if(CASE STREQUAL "drift")
    check_mindsplatter_replay_revision("msp-heavy-search-v1" "msp-heavy-search-v2")
  else()
    check_mindsplatter_replay_revision("no revision here" "nor here")
  endif()
  return()
endif()
check_mindsplatter_replay_revision("msp-heavy-search-v1" "msp-heavy-search-v1")
execute_process(
  COMMAND "${CMAKE_COMMAND}" -DCASE=${CASE} -DCHILD=ON -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE _rc
  ERROR_VARIABLE _err)
if(_rc EQUAL 0)
  message(FATAL_ERROR "${CASE} replay revisions were accepted")
endif()
string(FIND "${_err}" "MindSplatter replay revision ${CASE}" _diagnostic)
if(_diagnostic EQUAL -1)
  message(FATAL_ERROR "unexpected ${CASE} diagnostic:\n${_err}")
endif()
message(STATUS "MindSplatter replay revision ${CASE}: named rejection confirmed")
