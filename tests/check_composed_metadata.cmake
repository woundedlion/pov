cmake_minimum_required(VERSION 3.29)
set(define_flags)
foreach(definition IN LISTS DEFINES)
  list(APPEND define_flags "-D${definition}")
endforeach()
function(check_fixture macro diagnostic)
  execute_process(COMMAND "${COMPILER}" -std=gnu++20 -fsyntax-only
    "-I${ROOT}" ${define_flags} ${macro}
    "${ROOT}/tests/composed_metadata_check.cpp"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT diagnostic AND NOT result EQUAL 0)
    message(FATAL_ERROR "valid metadata companion rejected: ${output}${error}")
  elseif(diagnostic)
    if(result EQUAL 0)
      message(FATAL_ERROR "invalid metadata fixture accepted: ${macro}")
    endif()
    if(NOT "${output}${error}" MATCHES "${diagnostic}")
      message(FATAL_ERROR "wrong metadata refusal: ${output}${error}")
    endif()
  endif()
endfunction()
check_fixture("" "")
check_fixture(-DHS_METADATA_REDUNDANT_SCALAR "declare topology through typed pipeline entries")
check_fixture(-DHS_METADATA_UNKNOWN_COVERAGE "unsupported projection coverage policy")
check_fixture(-DHS_METADATA_MISSING_PROJECT "projection stage is required")
check_fixture(-DHS_METADATA_UNTRACKED_HUE "path length hue must match pipeline tracking")
message(STATUS "composed metadata contracts passed")
