#!/bin/sh
# Holosphere pre-commit hook — build and run the native unit tests, aborting the
# commit if anything fails.
#
# ON BY DEFAULT (opt-out). Configuring the `tests` CMake preset enables it
# automatically (core.hooksPath=.githooks; see CMakeLists.txt). To enable it by
# hand for a fresh clone:
#     git config core.hooksPath .githooks
#
# Opt OUT of a single commit:
#     HS_SKIP_TESTS=1 git commit ...        (or:  git commit --no-verify)
#
# Uses the CMake "tests" preset (Ninja + auto-located Clang). Configure is cached
# and builds are incremental, so a typical commit pays only the changed-file
# rebuild plus the ~4s test run. Doc-only commits skip the suite entirely.
#
# SCOPE: the "run or skip" decision keys on the STAGED paths (git diff --cached),
# but the build/test below compiles the WORKING TREE, not the index. For whole-
# file commits these coincide. With partial staging (git add -p) they can differ:
# the suite then validates unstaged content, so a split commit can pass here while
# its staged hunks alone do not compile. CI rebuilds from the committed tree and
# is the authoritative gate for that case; this hook is a fast local pre-filter.
#
# COVERAGE GAP (frame-cyclic paths): this hook runs the suite with the default
# HS_SMOKE_FRAMES (8 — see DEFAULT_SMOKE_FRAMES in tests/test_fixture.h), which never
# reaches the long cyclic windows: effect morph cycles, particle/trail wraps,
# FIFO/slot expiry (Thrusters, RingShower), ShapeShifter's 48-frame cut, and
# arena compaction. The unit_arena_budget / unit_stack_budget gates resolve the
# same window, so their high-water marks are short here too.
# CI sets HS_SMOKE_FRAMES=120 (.github/workflows/ci.yml) to
# exercise them on every push/PR, so a green pre-commit is NOT authoritative for
# those paths — a regression there fails only in CI, by design (the hook stays
# fast).
#
# COVERAGE GAP (effects module tier): likewise, the effects module runs its
# QUICK tier locally (device-resolution <96,20> smoke + determinism only, ~2 s),
# because its full-resolution 288x144 passes and white-box correctness block cost
# ~40 s — too slow for the per-commit hook. CI sets HS_EFFECTS_FULL=1 to run that
# full tier on every push/PR, so a green pre-commit is NOT authoritative for the
# production-resolution render paths or those white-box invariants (see
# effects_full_suite() in tests/test_effects.h). Reproduce locally with
# HS_EFFECTS_FULL=1 git commit. To reproduce CI locally: HS_SMOKE_FRAMES=120 ctest --preset tests, or
# run the full window through this hook with HS_SMOKE_FRAMES=120 git commit (the
# env passes through to ctest). The death suite is likewise weaker locally: when
# the harness cannot self-spawn a child it SKIPS its trap cases here (a loud
# failure only under CI, where CI=true), so a green pre-commit proves neither the
# long cyclic windows nor every trap — CI is the authoritative gate.

set -e

# Run only when C++/CMake/test sources are staged; skip doc-only commits.
# Include D (deletions) and R (renames): removing or renaming a C++/build file is
# exactly the change class most likely to break other checkouts, so it must run
# the suite too. (A renamed/deleted path still matches the extension grep below.)
# tests/ubsan-ignorelist.txt is included because it directly changes what the
# sanitizer build suppresses, so a local edit should re-run the suite. The
# justfile / .github/workflows/ci.yml / .githooks cases are intentionally left to
# CI (which rebuilds from the committed tree and is the authoritative gate).
CHANGED="$(git diff --cached --name-only --diff-filter=ACMRD)"

# ─── clang-format check (first-party C++ only) ──────────────────────────────
# Verify staged C++ matches the committed .clang-format. Scoped to first-party
# sources: core/vendor/ and the generated color_luts.h / gamut_lut.h /
# reaction_graph.cpp are excluded. Checks the working-tree file (same partial-staging caveat as the
# suite above). Skipped if clang-format is absent (a contributor without it still
# commits — CI's clang-format job gates the whole tracked tree) or via
# HS_SKIP_FORMAT=1. Ordered ahead of the HS_SKIP_TESTS opt-out: that flag stands
# down the test and Teensy gates only, never this check.
#
# clang-format reflows code between LLVM majors, so a binary of a different major
# than the CI job's disagrees in BOTH directions: it rejects code the gate accepts
# and accepts code the gate rejects. Its verdict is therefore ADVISORY — reported,
# never blocking — so a contributor without clang-format-$HS_CLANG_FORMAT_MAJOR
# still commits. Only a matching major (or an unparseable --version, assumed to be
# a wrapper for the pinned binary) blocks. Set CLANG_FORMAT to override the binary
# (the ci.yml jobs pass clang-format-18 the same way).
HS_CLANG_FORMAT_MAJOR=18
if [ -z "$HS_SKIP_FORMAT" ]; then
  FORMAT="$(printf '%s\n' "$CHANGED" \
    | grep -E '\.(h|hpp|cpp|cc|inl)$' \
    | grep -vE '(^|/)core/vendor/|(^|/)core/color/color_luts\.h$|(^|/)core/color/gamut_lut\.h$|(^|/)core/engine/reaction_graph\.cpp$' || true)"
  if [ -n "$FORMAT" ]; then
    CF="${CLANG_FORMAT:-clang-format}"
    if command -v "$CF" >/dev/null 2>&1; then
      cf_version="$("$CF" --version 2>/dev/null | sed -n 's/.*version \([0-9][0-9]*\).*/\1/p')"
      echo "[pre-commit] Checking clang-format on staged first-party C++ ($CF ${cf_version:-unknown})..."
      advisory=
      if [ -n "$cf_version" ] && [ "$cf_version" != "$HS_CLANG_FORMAT_MAJOR" ]; then
        advisory=1
        echo "[pre-commit] clang-format $cf_version differs from CI's clang-format-$HS_CLANG_FORMAT_MAJOR;"
        echo "[pre-commit] it reflows differently, so its verdict is advisory and does not block."
        echo "[pre-commit] (point CLANG_FORMAT at a clang-format-$HS_CLANG_FORMAT_MAJOR binary to enforce the gate)"
      fi
      unformatted=
      for f in $FORMAT; do
        [ -f "$f" ] || continue     # deleted/renamed-away path: nothing to check
        "$CF" --dry-run --Werror --style=file "$f" >/dev/null 2>&1 \
          || unformatted="$unformatted $f"
      done
      if [ -n "$unformatted" ] && [ -n "$advisory" ]; then
        echo "[pre-commit] clang-format $cf_version reports unformatted files:$unformatted"
        echo "[pre-commit] (advisory only — confirm with clang-format-$HS_CLANG_FORMAT_MAJOR before reformatting)"
      elif [ -n "$unformatted" ]; then
        echo "[pre-commit] clang-format found unformatted files:$unformatted"
        echo "[pre-commit] (fix with: $CF -i$unformatted, or bypass once with HS_SKIP_FORMAT=1 / --no-verify)"
        exit 1
      else
        echo "[pre-commit] clang-format clean."
      fi
    else
      echo "[pre-commit] $CF not found — skipping format check (install it to enable)."
    fi
  fi
fi

# Per-commit opt-out for the test + Teensy gates below.
if [ -n "$HS_SKIP_TESTS" ]; then
  echo "[pre-commit] HS_SKIP_TESTS set — skipping unit tests."
  exit 0
fi

# Two gates key off the staged paths. NATIVE: the host unit suite (C++/CMake).
# TEENSY: the Teensy 4 size/layout gate, which any C++ change can move, plus the
# build/budget/ldscript files that drive the firmware image.
NATIVE=
TEENSY=
if printf '%s\n' "$CHANGED" | grep -qE '\.(h|hpp|cpp|cc|inl)$|(^|/)CMakeLists\.txt$|(^|/)CMakePresets\.json$|(^|/)cmake/|(^|/)tests/ubsan-ignorelist\.txt$'; then
  NATIVE=1
fi
if printf '%s\n' "$CHANGED" | grep -qE '\.(h|hpp|cpp|cc|inl|ino)$|(^|/)platformio\.ini$|(^|/)tools/teensy_[A-Za-z_]*\.py$|(^|/)tools/teensy_budgets\.json$|(^|/)tools/phantasm\.ld$'; then
  TEENSY=1
fi
if [ -z "$NATIVE" ] && [ -z "$TEENSY" ]; then
  echo "[pre-commit] No C++/build changes staged — skipping unit tests + Teensy gate."
  exit 0
fi

# Caveat: emscripten-only TUs (e.g. targets/wasm/wasm.cpp, guarded entirely by
# #ifdef __EMSCRIPTEN__) match the grep above and so trigger this hook, but they
# are NOT part of the native test target — none of their changed code is compiled
# here. An embind signature typo passes this gate and fails only in CI's wasm
# job. Catching it locally would require an `emcc` syntax pass (EMSDK-gated),
# deliberately omitted to keep the per-commit hook fast.
if [ -n "$NATIVE" ]; then
  echo "[pre-commit] Building + running unit tests (cmake --preset tests)..."
  if ! { cmake --preset tests && cmake --build --preset tests && ctest --preset tests --output-on-failure; }; then
    echo "[pre-commit] Unit tests FAILED — commit aborted."
    echo "[pre-commit] (fix the tests, or bypass once with: HS_SKIP_TESTS=1 git commit  /  --no-verify)"
    exit 1
  fi
  echo "[pre-commit] Unit tests passed."
fi

# ─── Teensy 4 size/layout gate (both shipping images) ───────────────────────
# Build both images and let the post-build extra_script
# (tools/teensy_gate_extra.py) enforce the per-region budgets in
# tools/teensy_budgets.json — a non-zero exit aborts the commit. Phantasm is the
# binding RAM1 image, but Holosphere has its own budget/layout, so both are gated
# here; holosphere_dma rides along as a compile+link drift check for
# pov_single.h's USE_DMA_LEDS path, which no shipping image builds. CI's
# teensy-size job builds three further ungated environments (phantasm8, profile,
# profile_o3); they are omitted here to keep the per-commit hook fast, so CI is
# the authoritative gate for those compile paths. Skipped if PlatformIO is
# absent (a contributor without the ARM toolchain still commits — CI catches it)
# or via HS_SKIP_TEENSY=1.
if [ -n "$TEENSY" ] && [ -z "$HS_SKIP_TEENSY" ]; then
  if command -v pio >/dev/null 2>&1; then
    echo "[pre-commit] Teensy size/layout gate (pio run -e holosphere -e phantasm -e holosphere_dma)..."
    if ! pio run -e holosphere -e phantasm -e holosphere_dma; then
      echo "[pre-commit] Teensy size/layout gate FAILED — commit aborted."
      echo "[pre-commit] (bypass once with: HS_SKIP_TEENSY=1 git commit  /  --no-verify)"
      exit 1
    fi
    echo "[pre-commit] Teensy gate passed."
  else
    echo "[pre-commit] PlatformIO (pio) not found — skipping Teensy gate (CI enforces it)."
  fi
fi

exit 0
