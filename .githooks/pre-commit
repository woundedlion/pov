#!/bin/sh
# Holosphere pre-commit hook — build and run the native unit tests, aborting the
# commit if anything fails.
#
# ON BY DEFAULT (opt-out). Configuring the `tests` CMake preset enables it
# automatically (core.hooksPath=.githooks; see CMakeLists.txt). To enable it by
# hand for a fresh clone:
#     git config core.hooksPath .githooks
#
# Opt OUT of a single commit:
#     HS_SKIP_TESTS=1 git commit ...        (or:  git commit --no-verify)
# Narrower opt-outs: HS_SKIP_LINT=1 (Python/JS/Markdown), HS_SKIP_TEENSY=1.
#
# Uses the CMake "tests" preset (Ninja + auto-located Clang). Configure is cached
# and builds are incremental, so a typical commit pays only the changed-file
# rebuild plus the ~4s test run. A commit staging no C++/build path skips the
# suite entirely; a Markdown-only one still pays the seconds-long docs check.
#
# SCOPE: the "run or skip" decision keys on the STAGED paths (git diff --cached),
# but the build/test below compiles the WORKING TREE, not the index. For whole-
# file commits these coincide. With partial staging (git add -p) they can differ:
# the suite then validates unstaged content, so a split commit can pass here while
# its staged hunks alone do not compile. CI rebuilds from the committed tree and
# is the authoritative gate for that case; this hook is a fast local pre-filter.
#
# COVERAGE GAP (frame-cyclic paths): this hook runs the suite with the default
# HS_SMOKE_FRAMES (8 — see DEFAULT_SMOKE_FRAMES in tests/test_fixture.h), which never
# reaches the long cyclic windows: effect morph cycles, particle/trail wraps,
# FIFO/slot expiry (Thrusters, RingShower), ShapeShifter's 48-frame cut, and
# arena compaction. The unit_arena_budget / unit_stack_budget gates resolve the
# same window, so their high-water marks are short here too.
# CI sets HS_SMOKE_FRAMES=120 (.github/workflows/ci.yml) to
# exercise them on every push/PR, so a green pre-commit is NOT authoritative for
# those paths — a regression there fails only in CI, by design (the hook stays
# fast).
#
# COVERAGE GAP (effects module tier): likewise, the effects module runs its
# QUICK tier locally (device-resolution <96,20> smoke + determinism only, ~2 s),
# because its full-resolution 288x144 passes and white-box correctness block cost
# ~40 s — too slow for the per-commit hook. CI sets HS_EFFECTS_FULL=1 to run that
# full tier on every push/PR, so a green pre-commit is NOT authoritative for the
# production-resolution render paths or those white-box invariants (see
# effects_full_suite() in tests/test_effects.h). Reproduce locally with
# HS_EFFECTS_FULL=1 git commit. To reproduce CI locally: HS_SMOKE_FRAMES=120 ctest --preset tests, or
# run the full window through this hook with HS_SMOKE_FRAMES=120 git commit (the
# env passes through to ctest). The death suite is likewise weaker locally: when
# the harness cannot self-spawn a child it SKIPS its trap cases here (a loud
# failure only under CI, where CI=true), so a green pre-commit proves neither the
# long cyclic windows nor every trap — CI is the authoritative gate.

set -e

# Run only when C++/CMake/test sources are staged; skip doc-only commits.
# Include D (deletions) and R (renames): removing or renaming a C++/build file is
# exactly the change class most likely to break other checkouts, so it must run
# the suite too. (A renamed/deleted path still matches the extension grep below.)
# tests/ubsan-ignorelist.txt is included because it directly changes what the
# sanitizer build suppresses, so a local edit should re-run the suite. The
# justfile / .github/workflows/ci.yml / .githooks cases are intentionally left to
# CI (which rebuilds from the committed tree and is the authoritative gate).
CHANGED="$(git diff --cached --name-only --diff-filter=ACMRD)"

# ─── clang-format check (first-party C++ only) ──────────────────────────────
# Verify staged C++ matches the committed .clang-format. Scoped to first-party
# sources: core/vendor/ and the generated color_luts.h / gamut_lut.h /
# reaction_graph.cpp / mindsplatter_replay_corpus.h are excluded. The exclusion
# regex below is pinned against ci.yml's copy by tools/build_pins.py --check
# (SHARED_LITERALS). Checks the STAGED blob, not the working-tree file, so a
# partial `git add -p` is judged on exactly what the commit takes; the blob is
# also LF regardless of core.autocrlf. Ordered ahead of the HS_SKIP_TESTS
# opt-out: that flag stands down the test and Teensy gates only, never this
# check.
# HS_SKIP_FORMAT=1 is the one escape hatch.
#
# BLOCKING, and unconditionally so: an unformatted staged file fails the commit,
# and so does being unable to judge one. clang-format reflows code between LLVM
# majors, so a binary of a different major than CI's disagrees in both
# directions — its verdict cannot be trusted either way. A missing or
# wrong-major binary therefore fails too, rather than waving the commit through
# on no evidence. Install the pinned version (pip install
# clang-format==22.1.8) or point CLANG_FORMAT at a clang-format-$HS_CLANG_FORMAT_MAJOR
# binary (the ci.yml jobs pass it the same way). An unparseable --version fails
# for the same reason: a binary that cannot be identified cannot be matched to
# CI's, so trusting it would wave the commit through on no evidence.
HS_CLANG_FORMAT_MAJOR=22
if [ -z "$HS_SKIP_FORMAT" ]; then
  FORMAT="$(printf '%s\n' "$CHANGED" \
    | grep -E '\.(h|hpp|cpp|cc|inl)$' \
    | grep -vE '(^|/)core/vendor/|(^|/)core/color/color_luts\.h$|(^|/)core/color/gamut_lut\.h$|(^|/)core/engine/reaction_graph\.cpp$|(^|/)tests/mindsplatter_replay_corpus\.h$' || true)"
  if [ -n "$FORMAT" ]; then
    CF="${CLANG_FORMAT:-clang-format}"
    if command -v "$CF" >/dev/null 2>&1; then
      cf_version="$("$CF" --version 2>/dev/null | sed -n 's/.*version \([0-9][0-9]*\).*/\1/p')"
      echo "[pre-commit] Checking clang-format on staged first-party C++ ($CF ${cf_version:-unknown})..."
      if [ "$cf_version" != "$HS_CLANG_FORMAT_MAJOR" ]; then
        if [ -n "$cf_version" ]; then
          echo "[pre-commit] clang-format $cf_version differs from CI's clang-format-$HS_CLANG_FORMAT_MAJOR."
          echo "[pre-commit] Majors reflow differently, so this binary cannot judge the gate."
        else
          echo "[pre-commit] $CF --version reported no major, so which clang-format this is"
          echo "[pre-commit] cannot be established, and its verdict cannot be trusted either way."
        fi
        echo "[pre-commit] (pip install clang-format==22.1.8, or point CLANG_FORMAT at a"
        echo "[pre-commit]  clang-format-$HS_CLANG_FORMAT_MAJOR binary; bypass once with HS_SKIP_FORMAT=1)"
        exit 1
      fi
      unformatted=
      # Heredoc, not a pipe: the loop must accumulate in this shell. IFS= read -r
      # keeps a path containing whitespace or backslashes intact.
      while IFS= read -r f; do
        # deleted/renamed-away path: no staged blob to check
        git cat-file -e ":$f" 2>/dev/null || continue
        # --assume-filename so .clang-format resolves from the real repo path.
        git show ":$f" \
          | "$CF" --dry-run --Werror --style=file --assume-filename="$f" \
            >/dev/null 2>&1 \
          || unformatted="$unformatted $f"
      done <<EOF
$FORMAT
EOF
      if [ -n "$unformatted" ]; then
        echo "[pre-commit] clang-format found unformatted files:$unformatted"
        echo "[pre-commit] (fix with: $CF -i$unformatted && git add$unformatted,"
        echo "[pre-commit]  or bypass once with HS_SKIP_FORMAT=1 / --no-verify)"
        exit 1
      fi
      echo "[pre-commit] clang-format clean."
    else
      echo "[pre-commit] $CF not found, so the format gate cannot run."
      echo "[pre-commit] (pip install clang-format==22.1.8, or set CLANG_FORMAT;"
      echo "[pre-commit]  bypass once with HS_SKIP_FORMAT=1)"
      exit 1
    fi
  fi
fi

# Per-commit opt-out for the test, lint and Teensy gates below.
if [ -n "$HS_SKIP_TESTS" ]; then
  echo "[pre-commit] HS_SKIP_TESTS set — skipping unit tests."
  exit 0
fi

# Three gates key off the staged paths. NATIVE: the host unit suite (C++/CMake),
# including the .cmake test drivers and the Python generators whose committed
# output the suite consumes (an edit to one of those alone reds the suite and
# the matching provenance job with nothing else staged).
# TEENSY: the Teensy 4 size/layout gate, which any C++ change can move, plus the
# build/budget/ldscript files that drive the firmware image.
# LINT: the Python / JavaScript / Markdown tree, which no compiler sees — CI's
# lint and docs-markdown jobs are the only thing that reads it, and both run in
# seconds locally.
#
# Every classifier is a shell function taking the newline-separated path list,
# so tools/githook_tests drives them against a table of staged paths: these
# regexes are the hook's whole routing logic, and a path class that quietly
# stops matching skips its gate on every commit that touches only that class.
hs_paths_native() {
  printf '%s\n' "$1" | grep -qE '\.(h|hpp|cpp|cc|inl|cmake)$|(^|/)CMakeLists\.txt$|(^|/)CMakePresets\.json$|(^|/)cmake/|(^|/)tests/ubsan-ignorelist\.txt$|(^|/)scripts/generate_luts\.py$|(^|/)scripts/generate_reaction_graph\.py$|(^|/)tools/gen_gamut_lut\.py$|(^|/)tools/relax_bakes\.py$|(^|/)tools/teensy_size_trail\.py$'
}

hs_paths_teensy() {
  printf '%s\n' "$1" | grep -qE '\.(h|hpp|cpp|cc|inl|ino)$|(^|/)platformio\.ini$|(^|/)tools/teensy_[A-Za-z_]*\.py$|(^|/)tools/teensy_budgets\.json$|(^|/)tools/phantasm\.ld$'
}

hs_paths_lint() {
  printf '%s\n' "$1" | grep -qE '\.(py|mjs|md)$|(^|/)ruff\.toml$|(^|/)eslint\.config\.mjs$|(^|/)package(-lock)?\.json$'
}

NATIVE=
TEENSY=
LINT=
if hs_paths_native "$CHANGED"; then
  NATIVE=1
fi
if hs_paths_teensy "$CHANGED"; then
  TEENSY=1
fi
if hs_paths_lint "$CHANGED"; then
  LINT=1
fi
if [ -z "$NATIVE" ] && [ -z "$TEENSY" ] && [ -z "$LINT" ]; then
  echo "[pre-commit] Nothing a local gate covers is staged — skipping them all."
  exit 0
fi

# Probe with --version, not `command -v`: on Windows the App Execution Alias
# stub resolves and then refuses to run.
hs_python() {
  for c in ${HS_PYTHON:-} python3 python; do
    if "$c" --version >/dev/null 2>&1; then echo "$c"; return 0; fi
  done
  return 1
}

# ─── Python / JavaScript / Markdown checks ──────────────────────────────────
# The same checks as `just lint`, `just docs-check` and `npm test`, which are
# what CI's lint and docs-markdown jobs run. Each tool is skipped when it is
# absent, exactly as the Teensy gate below is: a contributor without ruff or
# without node_modules still commits, and CI stays the authoritative gate. ruff
# is held to the pin — a different release gates on a different rule set, so its
# verdict says nothing about CI's. Skip once with HS_SKIP_LINT=1.
hs_run_lint() {
  if PY="$(hs_python)"; then
    if "$PY" tools/build_pins.py --check-tool ruff >/dev/null 2>&1; then
      echo "[pre-commit] ruff..."
      if ! ruff check --no-cache .; then
        echo "[pre-commit] ruff found problems."
        return 1
      fi
    else
      echo "[pre-commit] ruff absent or off the pin — skipping it (CI enforces it)."
    fi
    # The checkers themselves, not their self-test suites: those build throwaway
    # git trees, which is CI's docs-markdown job to run, not a commit hook's.
    echo "[pre-commit] Markdown + build-pin checks..."
    if ! { "$PY" tools/docs_check.py && "$PY" tools/build_pins.py --check; }; then
      echo "[pre-commit] Markdown / build-pin checks FAILED."
      return 1
    fi
  else
    echo "[pre-commit] no working python — skipping the lint + docs checks."
  fi
  if command -v node >/dev/null 2>&1; then
    echo "[pre-commit] Node script unit tests..."
    if ! node --test scripts/*.test.mjs; then
      echo "[pre-commit] scripts/*.test.mjs FAILED."
      return 1
    fi
    # eslint comes from node_modules, which a fresh clone has not installed yet.
    if [ -x node_modules/.bin/eslint ]; then
      if ! node_modules/.bin/eslint .; then
        echo "[pre-commit] eslint found problems."
        return 1
      fi
    else
      echo "[pre-commit] node_modules absent — skipping eslint (npm ci enables it)."
    fi
  else
    echo "[pre-commit] node not found — skipping the JavaScript checks."
  fi
  echo "[pre-commit] Lint + docs checks passed."
}

if [ -n "$LINT" ] && [ -z "$HS_SKIP_LINT" ]; then
  # git exports GIT_DIR / GIT_INDEX_FILE to its hooks, and every checker below
  # shells out to git. Inherited, those point a checker run from anywhere back
  # at this commit's in-flight index; unset, each resolves the repository the
  # ordinary way.
  if ! ( unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX; hs_run_lint ); then
    echo "[pre-commit] (bypass once with: HS_SKIP_LINT=1 git commit)"
    exit 1
  fi
fi

# Caveat: emscripten-only TUs (e.g. targets/wasm/wasm.cpp, guarded entirely by
# #ifdef __EMSCRIPTEN__) match the grep above and so trigger this hook, but they
# are NOT part of the native test target — none of their changed code is compiled
# here. An embind signature typo passes this gate and fails only in CI's wasm
# job. Catching it locally would require an `emcc` syntax pass (EMSDK-gated),
# deliberately omitted to keep the per-commit hook fast.
if [ -n "$NATIVE" ]; then
  echo "[pre-commit] Building + running unit tests (cmake --preset tests)..."
  if ! { cmake --preset tests && cmake --build --preset tests && ctest --preset tests --output-on-failure; }; then
    echo "[pre-commit] Unit tests FAILED — commit aborted."
    echo "[pre-commit] (fix the tests, or bypass once with: HS_SKIP_TESTS=1 git commit  /  --no-verify)"
    exit 1
  fi
  echo "[pre-commit] Unit tests passed."
fi

# ─── Teensy 4 size/layout gate (both shipping images) ───────────────────────
# Build both images and let the post-build extra_script
# (tools/teensy_gate_extra.py) enforce the per-region budgets in
# tools/teensy_budgets.json — a non-zero exit aborts the commit. Phantasm is the
# binding RAM1 image, but Holosphere has its own budget/layout, so both are gated
# here; holosphere_dma rides along as a compile+link drift check for
# pov_single.h's USE_DMA_LEDS path, which no shipping image builds. CI's
# teensy-size job builds three further ungated environments (phantasm8, profile,
# profile_o3); they are omitted here to keep the per-commit hook fast, so CI is
# the authoritative gate for those compile paths. Skipped if PlatformIO is
# absent (a contributor without the ARM toolchain still commits — CI catches it)
# or via HS_SKIP_TEENSY=1.
if [ -n "$TEENSY" ] && [ -z "$HS_SKIP_TEENSY" ]; then
  if command -v pio >/dev/null 2>&1; then
    echo "[pre-commit] Teensy size/layout gate (pio run -e holosphere -e phantasm -e holosphere_dma)..."
    if ! pio run -e holosphere -e phantasm -e holosphere_dma; then
      echo "[pre-commit] Teensy size/layout gate FAILED — commit aborted."
      echo "[pre-commit] (bypass once with: HS_SKIP_TEENSY=1 git commit  /  --no-verify)"
      exit 1
    fi
    echo "[pre-commit] Teensy gate passed."
    # Capture the linked images' section sizes into a pending record; the
    # post-commit hook stamps it with the sha and appends it to the local size
    # trail. Advisory: any failure prints and the commit proceeds.
    if PY="$(hs_python)"; then
      if ! "$PY" tools/teensy_size_trail.py record --build-dir .pio/build; then
        echo "[pre-commit] size trail not recorded (see warning above) — continuing."
      fi
    else
      echo "[pre-commit] no working python — skipping size trail record."
    fi
  else
    echo "[pre-commit] PlatformIO (pio) not found — skipping Teensy gate (CI enforces it)."
  fi
fi

exit 0
