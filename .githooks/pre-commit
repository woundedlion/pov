#!/bin/sh
# Fast local feedback only. CI and the protected-branch `CI green` check are
# authoritative for builds, tests, firmware budgets and documentation.
set -eu

CHANGED="$(git diff --cached --name-only --diff-filter=ACMRD)"
PRESENT="$(git diff --cached --name-only --diff-filter=ACMR)"

FORMAT="$(printf '%s\n' "$CHANGED" \
  | grep -E '\.(h|hpp|cpp|cc|inl)$' \
  | grep -vE '(^|/)core/vendor/|(^|/)core/color/color_luts\.h$|(^|/)core/color/gamut_lut\.h$|(^|/)core/spatial/reaction_graph\.cpp$|(^|/)tests/mindsplatter_replay_corpus\.h$' \
  || true)"

if [ -n "$FORMAT" ] && [ -z "${HS_SKIP_FORMAT:-}" ]; then
  CF="${CLANG_FORMAT:-clang-format}"
  if ! command -v "$CF" >/dev/null 2>&1; then
    echo "[pre-commit] $CF not found (install clang-format 22 or use --no-verify)."
    exit 1
  fi
  major="$("$CF" --version | sed -n 's/.*version \([0-9][0-9]*\).*/\1/p')"
  if [ "$major" != 22 ]; then
    echo "[pre-commit] clang-format 22 is required; found ${major:-unknown}."
    exit 1
  fi
  failed=
  while IFS= read -r file; do
    git cat-file -e ":$file" 2>/dev/null || continue
    git show ":$file" \
      | "$CF" --dry-run --Werror --style=file --assume-filename="$file" \
        >/dev/null 2>&1 \
      || failed="$failed $file"
  done <<EOF
$FORMAT
EOF
  if [ -n "$failed" ]; then
    echo "[pre-commit] clang-format failed:$failed"
    exit 1
  fi
fi

PYTHON="$(printf '%s\n' "$PRESENT" | sed -n '/\.py$/p')"
if [ -n "$PYTHON" ] && command -v ruff >/dev/null 2>&1; then
  printf '%s\n' "$PYTHON" | xargs ruff check --no-cache
fi

JAVASCRIPT="$(printf '%s\n' "$PRESENT" | sed -n '/\.mjs$/p')"
if [ -n "$JAVASCRIPT" ] && [ -x node_modules/.bin/eslint ]; then
  printf '%s\n' "$JAVASCRIPT" | xargs node_modules/.bin/eslint
fi

exit 0
