#!/bin/sh
# Staged-only checks that predict the fast, deterministic CI gates.
set -eu

HS_CLANG_FORMAT_MAJOR=22

CHANGED="$(git diff --cached --name-only --diff-filter=ACMRD)"
PRESENT="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$CHANGED" ] || exit 0

STAGED_BLOB="$(mktemp "${TMPDIR:-/tmp}/hs-staged.XXXXXX")"
trap 'rm -f "$STAGED_BLOB"' EXIT INT TERM

# The linters read the staged blob, not the working tree. Piping `git show`
# straight into one hides its status behind the linter's, so a path the index
# cannot produce lints as empty input and passes.
extract_staged() {
  if ! git show ":$1" >"$STAGED_BLOB"; then
    echo "[pre-commit] cannot read staged $1 from the index."
    exit 1
  fi
}

if ! git diff --cached --check; then
  echo "[pre-commit] staged whitespace errors must be fixed."
  exit 1
fi

FORMAT="$(printf '%s\n' "$PRESENT" \
  | grep -E '\.(h|hpp|cpp|cc|inl)$' \
  | grep -vE '(^|/)core/vendor/|(^|/)core/color/color_luts\.h$|(^|/)core/color/gamut_lut\.h$|(^|/)core/spatial/reaction_graph\.cpp$|(^|/)tests/mindsplatter_replay_corpus\.h$' \
  || true)"

if [ -n "$FORMAT" ]; then
  CF="${CLANG_FORMAT:-clang-format}"
  if ! command -v "$CF" >/dev/null 2>&1; then
    echo "[pre-commit] $CF not found; install clang-format 22."
    exit 1
  fi
  major="$("$CF" --version | sed -n 's/.*version \([0-9][0-9]*\).*/\1/p')"
  if [ "$major" != "$HS_CLANG_FORMAT_MAJOR" ]; then
    echo "[pre-commit] clang-format 22 is required; found ${major:-unknown}."
    exit 1
  fi
  failed=
  while IFS= read -r file; do
    extract_staged "$file"
    "$CF" --dry-run --Werror --style=file --assume-filename="$file" \
      <"$STAGED_BLOB" >/dev/null 2>&1 \
      || failed="$failed $file"
  done <<EOF
$FORMAT
EOF
  if [ -n "$failed" ]; then
    echo "[pre-commit] clang-format failed:$failed"
    exit 1
  fi
fi

PYTHON_FILES="$(printf '%s\n' "$PRESENT" | sed -n '/\.py$/p')"
if [ -n "$PYTHON_FILES" ]; then
  if ! command -v ruff >/dev/null 2>&1; then
    echo "[pre-commit] ruff not found; pip install -r requirements/ruff.txt"
    exit 1
  fi
  while IFS= read -r file; do
    extract_staged "$file"
    ruff check --no-cache --stdin-filename "$file" - <"$STAGED_BLOB"
  done <<EOF
$PYTHON_FILES
EOF
fi

# sed, not grep -E: build_pins.py --check allows only one quoted grep -E
# pattern here, the clang-format extension list above.
JAVASCRIPT_FILES="$(printf '%s\n' "$PRESENT" | sed -n -E '/\.(js|cjs|mjs)$/p')"
if [ -n "$JAVASCRIPT_FILES" ]; then
  if [ ! -x node_modules/.bin/eslint ]; then
    echo "[pre-commit] node_modules is missing; run npm ci."
    exit 1
  fi
  while IFS= read -r file; do
    extract_staged "$file"
    node_modules/.bin/eslint --stdin --stdin-filename "$file" <"$STAGED_BLOB"
  done <<EOF
$JAVASCRIPT_FILES
EOF
fi

# `command -v python3` is not enough on Windows: the App Execution Alias stub
# resolves and then refuses to run. Probe with --version.
PYTHON_BIN=
for candidate in ${HS_PYTHON:-} python3 python; do
  if "$candidate" --version >/dev/null 2>&1; then PYTHON_BIN="$candidate"; break; fi
done
if [ -z "$PYTHON_BIN" ]; then
  echo "[pre-commit] no working Python found; documentation checks need one (set HS_PYTHON)."
  exit 1
fi

SNAPSHOT_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/hs-pre-commit.XXXXXX")"
SNAPSHOT="$SNAPSHOT_ROOT/repo"
trap 'rm -rf "$SNAPSHOT_ROOT" "$STAGED_BLOB"' EXIT INT TERM
mkdir "$SNAPSHOT"
git checkout-index --all --force --prefix="$SNAPSHOT/"
LOCAL_GIT_ENV="$(git rev-parse --local-env-vars)"
# The sibling checkout hangs off the MAIN worktree: --show-toplevel is
# whichever worktree the commit runs from, and the landing model is worktrees.
MAIN_TREE="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
INDEX_PATH="$(git rev-parse --path-format=absolute --git-path index)"

(
  for name in $LOCAL_GIT_ENV; do unset "$name"; done
  git -C "$SNAPSHOT" init --quiet
  cp "$INDEX_PATH" "$SNAPSHOT/.git/index"

  if [ -d "${DAYDREAM_CHECKOUT:-$MAIN_TREE/../daydream}" ]; then
    "$PYTHON_BIN" "$SNAPSHOT/tools/docs_check.py" --root "$SNAPSHOT" \
      --checkout "daydream=${DAYDREAM_CHECKOUT:-$MAIN_TREE/../daydream}"
  else
    "$PYTHON_BIN" "$SNAPSHOT/tools/docs_check.py" --root "$SNAPSHOT" \
      --skip-checkout daydream
  fi
  "$PYTHON_BIN" "$SNAPSHOT/tools/docs_images.py" --repo-root "$SNAPSHOT"
  "$PYTHON_BIN" "$SNAPSHOT/tools/build_pins.py" --check
  "$PYTHON_BIN" "$SNAPSHOT/tools/license_check.py" --root "$SNAPSHOT"
)

echo "[pre-commit] staged formatting, lint, and documentation checks passed."
