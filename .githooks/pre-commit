#!/bin/sh
# Staged-only checks that predict the fast, deterministic CI gates.
set -eu

HS_CLANG_FORMAT_MAJOR=22

CHANGED="$(git diff --cached --name-only --no-renames --diff-filter=ACMRD)"
PRESENT="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$CHANGED" ] || exit 0

STAGED_BLOB="$(mktemp "${TMPDIR:-/tmp}/hs-staged.XXXXXX")"
trap 'rm -f "$STAGED_BLOB"' EXIT INT TERM

# The linters read the staged blob, not the working tree. Piping `git show`
# straight into one hides its status behind the linter's, so a path the index
# cannot produce lints as empty input and passes.
extract_staged() {
  if ! GIT_INDEX_FILE="$INDEX_PATH" git show ":$1" >"$STAGED_BLOB"; then
    echo "[pre-commit] cannot read staged $1 from the index."
    exit 1
  fi
}

if ! git -c core.whitespace=blank-at-eol,blank-at-eof diff --cached --check; then
  echo "[pre-commit] staged whitespace errors must be fixed."
  exit 1
fi

# `command -v python3` is not enough on Windows: the App Execution Alias stub
# resolves and then refuses to run. Probe with --version.
PYTHON_BIN=
for candidate in "${HS_PYTHON:-}" python3 python; do
  if "$candidate" --version >/dev/null 2>&1; then PYTHON_BIN="$candidate"; break; fi
done
if [ -z "$PYTHON_BIN" ]; then
  echo "[pre-commit] no working Python found; documentation checks need one (set HS_PYTHON)."
  exit 1
fi
if ! "$PYTHON_BIN" -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
  echo "[pre-commit] Python 3.11 or newer is required; set HS_PYTHON to a supported interpreter."
  exit 1
fi

SNAPSHOT_ROOT="$(mktemp -d "$PWD/.hs-pre-commit.XXXXXX")"
SNAPSHOT="$SNAPSHOT_ROOT/repo"
trap 'rm -rf "$SNAPSHOT_ROOT" "$STAGED_BLOB"' EXIT INT TERM
mkdir "$SNAPSHOT"
if ! git checkout-index --all --force --prefix="$SNAPSHOT/"; then
  echo "[pre-commit] cannot materialize staged snapshot."
  exit 1
fi
LOCAL_GIT_ENV="$(git rev-parse --local-env-vars)"
INDEX_PATH="$(git rev-parse --path-format=absolute --git-path index)"

(
  for name in $LOCAL_GIT_ENV; do unset "$name"; done
  git -C "$SNAPSHOT" init --quiet
  cp "$INDEX_PATH" "$SNAPSHOT/.git/index"


require_clang_format() {
  "$PYTHON_BIN" "$SNAPSHOT/tools/build_pins.py" --check-tool clang-format
}

require_ruff() {
  if ! command -v ruff >/dev/null 2>&1; then
    echo "[pre-commit] ruff not found; pip install -r requirements/ruff.txt"
    exit 1
  fi
  expected_ruff="$(sed -n 's/^ruff==\([^ ]*\).*/\1/p' "$SNAPSHOT/requirements/ruff.txt")"
  if [ "$(ruff --version)" != "ruff $expected_ruff" ]; then
    echo "[pre-commit] pinned ruff $expected_ruff is required; pip install -r requirements/ruff.txt"
    exit 1
  fi
}

require_eslint() {
  if [ ! -x node_modules/.bin/eslint ]; then
    echo "[pre-commit] node_modules is missing; run npm ci."
    exit 1
  fi
}

FORMAT="$(printf '%s\n' "$PRESENT" \
  | grep -E '\.(h|hpp|cpp|cc|inl|ino)$' \
  | grep -vE '(^|/)core/vendor/FastNoiseLite\.h$|(^|/)core/color/color_luts\.h$|(^|/)core/color/gamut_lut\.h$|(^|/)core/color/srgb_decode_lut\.h$|(^|/)core/color/mindsplatter_palette_luts\.h$|(^|/)core/mesh/relax_bakes_generated\.h$|(^|/)core/spatial/reaction_graph\.cpp$|(^|/)tests/mindsplatter_replay_corpus\.h$' \
  || true)"

if [ -n "$FORMAT" ]; then
  require_clang_format
  CF="${CLANG_FORMAT:-clang-format}"
  if ! command -v "$CF" >/dev/null 2>&1; then
    echo "[pre-commit] $CF not found; install clang-format 22."
    exit 1
  fi
  major="$("$CF" --version | sed -n 's/.*version \([0-9][0-9]*\).*/\1/p')"
  if [ "$major" != "$HS_CLANG_FORMAT_MAJOR" ]; then
    echo "[pre-commit] clang-format 22 is required; found ${major:-unknown}."
    exit 1
  fi
  failed=
  while IFS= read -r file; do
    extract_staged "$file"
    "$CF" --dry-run --Werror --style=file --assume-filename="$SNAPSHOT/$file" \
      <"$STAGED_BLOB" >/dev/null 2>&1 \
      || failed="$failed $file"
  done <<EOF
$FORMAT
EOF
  if [ -n "$failed" ]; then
    echo "[pre-commit] clang-format failed:$failed"
    exit 1
  fi
fi

PYTHON_FILES="$(printf '%s\n' "$PRESENT" | sed -n '/\.py$/p')"
if [ -n "$PYTHON_FILES" ]; then
  require_ruff
  while IFS= read -r file; do
    extract_staged "$file"
    ruff check --no-cache --config "$SNAPSHOT/ruff.toml" --stdin-filename "$file" - <"$STAGED_BLOB"
  done <<EOF
$PYTHON_FILES
EOF
fi

JAVASCRIPT_FILES="$(printf '%s\n' "$PRESENT" | sed -n -E '/\.(js|cjs|mjs)$/p')"
if [ -n "$JAVASCRIPT_FILES" ]; then
  require_eslint
  while IFS= read -r file; do
    extract_staged "$file"
    node_modules/.bin/eslint --config "$SNAPSHOT/eslint.config.mjs" --stdin --stdin-filename "$file" <"$STAGED_BLOB"
  done <<EOF
$JAVASCRIPT_FILES
EOF
fi

  if printf '%s\n' "$CHANGED" | grep -qx '.clang-format'; then
    require_clang_format
    (cd "$SNAPSHOT" && bash tools/clang_format_gate.sh)
  fi
  if printf '%s\n' "$CHANGED" | grep -qx 'ruff.toml'; then
    require_ruff
    (cd "$SNAPSHOT" && ruff check --no-cache .)
  fi
  if printf '%s\n' "$CHANGED" | grep -qx 'eslint.config.mjs'; then
    require_eslint
    ESLINT="$PWD/node_modules/.bin/eslint"
    (cd "$SNAPSHOT" && "$ESLINT" .)
  fi

  SHELL_FILES="$(printf '%s\n' "$PRESENT" | grep -E '\.sh$|^\.githooks/' || true)"
  if [ -n "$SHELL_FILES" ]; then
    if ! command -v shellcheck >/dev/null 2>&1; then
      echo "[pre-commit] shellcheck not found; pip install -r requirements/shellcheck.txt"
      exit 1
    fi
    "$PYTHON_BIN" "$SNAPSHOT/tools/build_pins.py" --check-tool shellcheck
    while IFS= read -r file; do
      (cd "$SNAPSHOT" && shellcheck -x "$file")
    done <<EOF
$SHELL_FILES
EOF
  fi

  # No --sync: a repair here would land in the snapshot, not the index, and
  # would pass a README whose maps or counts have drifted from the tree.
  "$PYTHON_BIN" "$SNAPSHOT/tools/docs_check.py" --root "$SNAPSHOT" --skip-checkout daydream
  "$PYTHON_BIN" "$SNAPSHOT/tools/docs_images.py" --root "$SNAPSHOT"
  "$PYTHON_BIN" "$SNAPSHOT/tools/build_pins.py" --check
  "$PYTHON_BIN" "$SNAPSHOT/tools/license_check.py" --root "$SNAPSHOT"

  if printf '%s\n' "$CHANGED" | grep -Eq '^docs/profiles/|^scripts/(check_profiles|effect_roster)\.mjs$|^targets/(effects\.h|Phantasm/phantasm_playlist\.h)$|^\.githooks/pre-commit$'; then
    if ! command -v node >/dev/null 2>&1; then
      echo "[pre-commit] node not found; profile archive checks need the pinned Node version."
      exit 1
    fi
    "$PYTHON_BIN" "$SNAPSHOT/tools/build_pins.py" --check-tool node
    node "$SNAPSHOT/scripts/check_profiles.mjs"
  fi
)

echo "[pre-commit] staged formatting, lint, and documentation checks passed."
