#!/bin/sh
# Check new guards in each pushed range, then run the local CI over each commit
# being pushed; see tools/local_ci.sh.
set -eu

local_ci="$(git rev-parse --show-toplevel)/tools/local_ci.sh"
shas=
while read -r _local_ref local_sha _remote_ref remote_sha; do
  case $local_sha in
    *[!0]*) ;;
    *) continue ;;
  esac
  bash "$local_ci" --new-guards "$local_sha" "$remote_sha"
  case " $shas " in
    *" $local_sha "*) ;;
    *) shas="$shas $local_sha" ;;
  esac
done
[ -n "$shas" ] || exit 0
# shellcheck disable=SC2086
exec bash "$local_ci" --commit $shas
