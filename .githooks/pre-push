#!/bin/sh
# Run the local CI over each commit being pushed; see tools/local_ci.sh.
set -eu

shas=
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case $local_sha in
    *[!0]*) ;;
    *) continue ;;
  esac
  case " $shas " in
    *" $local_sha "*) ;;
    *) shas="$shas $local_sha" ;;
  esac
done
[ -n "$shas" ] || exit 0
# shellcheck disable=SC2086
exec bash "$(git rev-parse --show-toplevel)/tools/local_ci.sh" --commit $shas
